{
  "name": "lingora-functions",
  "private": true,
  "main": "lib/src/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "rm -rf lib && tsc",
    "build:watch": "tsc --watch",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "rm -rf lib-test && tsc -p tsconfig.test.json --outDir lib-test && NODE_ENV=test node --test \"lib-test/test/**/*.test.js\"",
    "start": "node lib/src/server.js",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,auth",
    "deploy": "firebase deploy --only functions,firestore",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.0.0",
    "jose": "^6.2.18",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/express": "^4.17.21"
  }
}
